# Copy to .env (gitignored) and change what you need. Every value has a working default,
# so Vaani runs fine without a .env at all.

# --- Storage ---------------------------------------------------------------
# Where voices, generations, the database and downloaded models live.
# Relative paths are resolved from the repo root.
VAANI_DATA_DIR=data
# Leave empty to use SQLite at $VAANI_DATA_DIR/vaani.db.
# e.g. Postgres: postgresql+psycopg://user:pass@localhost/vaani
DATABASE_URL=

# --- Voice engines ----------------------------------------------------------
# auto = Apple GPU (MPS) if available, else CPU. Or force: mps | cpu
VAANI_DEVICE=auto
# Engine used when a request doesn't name one: xtts | f5_mlx | indicf5
VAANI_DEFAULT_ENGINE=xtts
# Override the device for XTTS only (auto | mps | cpu); empty = follow VAANI_DEVICE.
VAANI_XTTS_DEVICE=
# F5-TTS MLX weights: empty = full (1.4 GB), 8 or 4 = quantized (smaller, slightly worse).
VAANI_F5MLX_QUANT=

# --- Transcription (Whisper) --------------------------------------------------
# Model used to transcribe clips; downloads into data/models/whisper on first use.
# Smaller option: mlx-community/whisper-small-mlx (0.48 GB, weaker Hindi).
VAANI_TRANSCRIBE_MODEL=mlx-community/whisper-large-v3-turbo
# Transcribe clips automatically while creating a voice.
VAANI_TRANSCRIBE_ON_CREATE=true

# --- Built-in voices --------------------------------------------------------------
# Add the 12 built-in studio voices (from the XTTS-v2 model) on first start.
VAANI_SEED_BUILTIN_VOICES=true

# --- Generation ---------------------------------------------------------------
# Pauses inserted between generated sentences and paragraphs (milliseconds).
VAANI_PAUSE_SENTENCE_MS=350
VAANI_PAUSE_PARAGRAPH_MS=800
# Pause between speakers in a dialogue script.
VAANI_PAUSE_TURN_MS=500
# Comma-separated experimental feature flags.
VAANI_FEATURES=

# --- Server & safety ------------------------------------------------------------
# The backend only listens on this machine.
VAANI_HOST=127.0.0.1
VAANI_PORT=8000
# Largest upload in one request (MB). Each file is also capped at 200 MB.
VAANI_MAX_UPLOAD_MB=1024
# Hosts and browser origins allowed to talk to the API (JSON lists). Keep these local:
# they stop other websites from reaching your recordings.
# VAANI_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
# VAANI_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
