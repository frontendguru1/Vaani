# Copy to .env (gitignored) and adjust. Every value has a sensible default.

# Where voices, generations, the database and model weights live.
# Relative paths are resolved from the repo root.
VAANI_DATA_DIR=data

# Leave empty to use SQLite at $VAANI_DATA_DIR/vaani.db.
# Postgres later: postgresql+psycopg://user:pass@localhost/vaani
DATABASE_URL=

# auto = try MPS, fall back to CPU. Or force: mps | cpu
VAANI_DEVICE=auto

# Engine used when a request doesn't name one.
VAANI_DEFAULT_ENGINE=xtts

# Pauses inserted when stitching generated chunks (milliseconds).
VAANI_PAUSE_SENTENCE_MS=350
VAANI_PAUSE_PARAGRAPH_MS=800

# Comma-separated experimental feature flags, e.g. "dialogue,srt"
VAANI_FEATURES=

# Backend bind address (dev server).
VAANI_HOST=127.0.0.1
VAANI_PORT=8000

# Keep Hugging Face / torch caches inside the project and offline-friendly.
HF_HOME=data/models/hf
HF_HUB_DISABLE_TELEMETRY=1
PYTORCH_ENABLE_MPS_FALLBACK=1
